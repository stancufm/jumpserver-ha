[Unit]
Description=Pull operational configuration from active jumpserver
Wants=network-online.target
After=network-online.target keepalived.service

[Service]
Type=oneshot
User=shadow-ha
Group=shadow-ha
ExecStart=/usr/local/sbin/shadow-ha-sync
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/jumpserver-ha
ReadWritePaths=/var/lib/shadow-ha-sync
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
MemoryDenyWriteExecute=true
TimeoutStartSec=30m
