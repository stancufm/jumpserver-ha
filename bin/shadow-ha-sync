#!/usr/bin/env bash
set -euo pipefail

readonly config='/etc/jumpserver-ha/role.conf'
[[ -r "$config" ]] || { echo "Missing $config" >&2; exit 1; }
# shellcheck disable=SC1090
source "$config"
readonly source_host="$JUMPSERVER_HA_ACTIVE_ADDRESS"
readonly source_port="$JUMPSERVER_HA_SSH_PORT"
readonly vip="$JUMPSERVER_HA_VIP"
readonly source_user='shadow-export'
readonly state_dir='/var/lib/shadow-ha-sync'
readonly key_file='/etc/shadow-ha/keys/sync_ed25519'
readonly known_hosts='/etc/shadow-ha/master_known_hosts'

install -d -o root -g root -m 0750 "$state_dir"
exec 9>"${state_dir}/sync.lock"
flock -n 9 || exit 0
if ip -4 -o addr show | grep -qF "${vip}/32"; then
  logger -t shadow-ha-sync 'VIP is present locally; passive synchronization skipped.'
  exit 0
fi
[[ -r "$key_file" && -r "$known_hosts" ]] || { echo 'Missing sync key or known_hosts pin.' >&2; exit 1; }

archive="$(mktemp "${state_dir}/incoming.XXXXXX.tar.gz")"
listing="$(mktemp "${state_dir}/listing.XXXXXX")"
trap 'rm -f "$archive" "$listing"' EXIT
ssh -F /dev/null -i "$key_file" -p "$source_port" -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile="$known_hosts" "${source_user}@${source_host}" > "$archive"
tar -tzf "$archive" > "$listing"
for required in usr/local/bin/gr etc/gr/config.json home/mihai.stancu/.config/gr/config.json home/mihai.stancu/.password-store/.gpg-id; do
  grep -qxF "$required" "$listing" || { echo "Missing required export path: $required" >&2; exit 1; }
done
tar -xzf "$archive" -C / --numeric-owner
systemctl daemon-reload
systemctl disable --now gr-vendor-update.timer 2>/dev/null || true
sha256sum "$archive" | awk '{print $1}' > "${state_dir}/last-archive.sha256"
printf '%s source=%s\n' "$(date --iso-8601=seconds)" "$source_host" > "${state_dir}/last-success"
logger -t shadow-ha-sync 'Passive configuration and user-data synchronization completed successfully.'
