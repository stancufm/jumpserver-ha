#!/usr/bin/env bash
# Check and explicitly apply releases of this project without requiring Git.
set -euo pipefail
readonly project_dir='/opt/jumpserver-ha'
readonly state_dir='/var/lib/jumpserver-ha'
readonly log_tag='jumpserver-ha-update'
readonly archive_url='https://github.com/stancufm/jumpserver-ha/archive/refs/heads/main.tar.gz'

usage() { echo "Usage: jumpserver-ha-update --check|--apply"; }
[[ $# -eq 1 ]] || { usage >&2; exit 2; }
mode="$1"
[[ "$mode" == '--check' || "$mode" == '--apply' ]] || { usage >&2; exit 2; }
[[ "$(id -u)" -eq 0 ]] || { echo 'Run as root.' >&2; exit 1; }
[[ -d "$project_dir" && -r "$project_dir/VERSION" ]] || { echo "Missing installed project: $project_dir" >&2; exit 1; }
install -d -o root -g root -m 0750 "$state_dir"
exec 9>"${state_dir}/update.lock"
flock -n 9 || exit 0

archive="$(mktemp "${state_dir}/update.XXXXXX.tar.gz")"
extract_dir="$(mktemp -d "${state_dir}/update.XXXXXX")"
trap 'rm -f "$archive"; rm -rf "$extract_dir"' EXIT
wget -q -O "$archive" "$archive_url"
tar -xzf "$archive" -C "$extract_dir"
candidate_dir="$(find "$extract_dir" -mindepth 1 -maxdepth 1 -type d -name 'jumpserver-ha-*' -print -quit)"
[[ -n "$candidate_dir" && -r "$candidate_dir/VERSION" && -r "$candidate_dir/install.sh" ]] || { echo 'Downloaded archive does not contain a valid release.' >&2; exit 1; }
local_version="$(tr -d '[:space:]' < "$project_dir/VERSION")"
remote_version="$(tr -d '[:space:]' < "$candidate_dir/VERSION")"
printf '%s local=%s remote=%s\n' "$(date --iso-8601=seconds)" "$local_version" "$remote_version" > "${state_dir}/last-update-check"
if [[ "$local_version" == "$remote_version" ]]; then
  logger -t "$log_tag" 'No update available.'
  exit 0
fi
if [[ "$mode" == '--check' ]]; then
  logger -t "$log_tag" "Update available: $local_version -> $remote_version. Run jumpserver-ha-update --apply after review."
  echo "Update available: $local_version -> $remote_version"
  exit 0
fi
[[ -r /etc/jumpserver-ha/role.conf ]] || { echo 'Missing installed role configuration.' >&2; exit 1; }
# shellcheck disable=SC1091
source /etc/jumpserver-ha/role.conf
staging="/opt/.jumpserver-ha.staging.$$"
backup="/opt/jumpserver-ha.previous"
rm -rf "$staging"
cp -a "$candidate_dir" "$staging"
rm -rf "$backup"
mv "$project_dir" "$backup"
mv "$staging" "$project_dir"
if ! /bin/bash "$project_dir/install.sh" --role standby --active-address "$JUMPSERVER_HA_ACTIVE_ADDRESS" --ssh-port "$JUMPSERVER_HA_SSH_PORT" --vip "$JUMPSERVER_HA_VIP" --upgrade; then
  rm -rf "$project_dir"
  mv "$backup" "$project_dir"
  echo 'Installation failed; restored the previous project directory.' >&2
  exit 1
fi
logger -t "$log_tag" "Updated and reinstalled $local_version -> $remote_version."
