#!/usr/bin/env bash
set -euo pipefail

readonly config_dir="${SHADOW_HA_CONFIG_DIR:-/etc/jumpserver-ha}"
readonly role_file="$config_dir/role.conf"
readonly paths_file="$config_dir/sync-paths"
readonly users_file="$config_dir/sync-users"
readonly export_state_dir="${SHADOW_HA_EXPORT_STATE_DIR:-/var/lib/shadow-ha-export-state}"

[[ -r "$role_file" && -r "$paths_file" && -r "$users_file" ]] || {
  echo 'HA exporter configuration is incomplete.' >&2
  exit 2
}
# shellcheck disable=SC1090
source "$role_file"
[[ "${JUMPSERVER_HA_ROLE:-}" == active ]] || {
  echo 'HA exporter is available only on the active node.' >&2
  exit 2
}
readonly full_clone="${JUMPSERVER_HA_FULL_CLONE:-${JUMPSERVER_HA_SYNC_SECRETS:-false}}"
[[ "$full_clone" == true || "$full_clone" == false ]] || {
  echo 'JUMPSERVER_HA_FULL_CLONE must be true or false.' >&2
  exit 2
}

[[ "$export_state_dir" == /* && "$export_state_dir" != / ]] || {
  echo 'Unsafe exporter state directory.' >&2
  exit 2
}
if [[ "$(id -u)" -eq 0 ]]; then
  install -d -o root -g root -m 0700 "$export_state_dir"
else
  [[ -n "${SHADOW_HA_EXPORT_STATE_DIR:-}" ]] || {
    echo 'The production exporter must run as root.' >&2
    exit 2
  }
  install -d -m 0700 "$export_state_dir"
fi
[[ ! -L "$export_state_dir" ]] || { echo 'Exporter state directory may not be a symlink.' >&2; exit 2; }
stage=$(mktemp -d "${export_state_dir}/export.XXXXXX")
trap 'rm -rf -- "$stage"' EXIT
install -d -m 0700 "$stage/metadata" "$stage/rootfs"

python3 - "$users_file" "$stage/metadata/users.tsv" "$stage/metadata/groups.tsv" \
  "$stage/metadata/shadow" "$full_clone" <<'PY'
import grp
import os
import pwd
import sys

users_file, users_output, groups_output, shadow_output, full_clone = sys.argv[1:]
with open(users_file, encoding="utf-8") as handle:
    requested = [line.strip() for line in handle if line.strip() and not line.lstrip().startswith("#")]

excluded = {"nobody", "shadow-ha", "shadow-export", "gr-collector"}
if requested == ["auto"]:
    selected = [entry for entry in pwd.getpwall()
                if 1000 <= entry.pw_uid < 60000
                and entry.pw_name not in excluded
                and entry.pw_dir.startswith("/home/")
                and entry.pw_shell not in ("/usr/sbin/nologin", "/bin/false")]
else:
    selected = []
    for name in requested:
        if name == "auto" or not name.replace("-", "").replace("_", "").isalnum():
            raise SystemExit("Invalid synchronized user: {}".format(name))
        try:
            selected.append(pwd.getpwnam(name))
        except KeyError:
            raise SystemExit("Configured synchronized user does not exist: {}".format(name))

group_entries = {entry.gr_name: entry for entry in grp.getgrall()}
needed_groups = set()
user_rows = []
for entry in selected:
    primary = grp.getgrgid(entry.pw_gid)
    needed_groups.add(primary.gr_name)
    supplementary = sorted(group.gr_name for group in group_entries.values()
                           if entry.pw_name in group.gr_mem and group.gr_gid != entry.pw_gid)
    needed_groups.update(supplementary)
    values = (entry.pw_name, str(entry.pw_uid), str(entry.pw_gid), primary.gr_name,
              entry.pw_dir, entry.pw_shell, ",".join(supplementary))
    if any("\t" in value or "\n" in value for value in values):
        raise SystemExit("Unsafe account metadata for {}".format(entry.pw_name))
    user_rows.append(values)

with open(users_output, "w", encoding="utf-8", newline="\n") as handle:
    for values in sorted(user_rows):
        handle.write("\t".join(values) + "\n")
with open(groups_output, "w", encoding="utf-8", newline="\n") as handle:
    for name in sorted(needed_groups):
        group = group_entries[name]
        handle.write("{}\t{}\n".format(group.gr_name, group.gr_gid))

selected_names = {entry.pw_name for entry in selected}
shadow_rows = {}
if full_clone == "true":
    with open("/etc/shadow", encoding="utf-8") as handle:
        for raw in handle:
            fields = raw.rstrip("\n").split(":")
            if len(fields) == 9 and fields[0] in selected_names:
                shadow_rows[fields[0]] = fields
    missing = selected_names.difference(shadow_rows)
    if missing:
        raise SystemExit("Missing shadow metadata for selected accounts")
with open(shadow_output, "w", encoding="utf-8", newline="\n") as handle:
    for name in sorted(shadow_rows):
        handle.write(":".join(shadow_rows[name]) + "\n")
PY
chmod 0600 "$stage/metadata/shadow"

dpkg-query -W -f='${binary:Package}\t${Version}\t${Status}\n' 2>/dev/null \
  | awk -F '\t' '$3 == "install ok installed" {print $1 "\t" $2}' \
  | LC_ALL=C sort > "$stage/metadata/packages.tsv"

{
  printf 'format=shadow-ha-v3\n'
  printf 'created_utc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf 'source_hostname=%s\n' "$(hostname)"
  printf 'full_clone=%s\n' "$full_clone"
} > "$stage/metadata/manifest"

copy_relative() {
  local source=$1
  [[ "$source" == /* && "$source" != / && "$source" != *'/../'* && "$source" != */.. ]] || {
    echo "Unsafe synchronized path: $source" >&2
    exit 2
  }
  [[ -e "$source" ]] || {
    echo "Configured synchronized path does not exist: $source" >&2
    exit 2
  }
  [[ ! -L "$source" ]] || { echo "Synchronized path may not be a symlink: $source" >&2; exit 2; }
  local rsync_args=(-aHAX --numeric-ids --relative --exclude='.collect.lock')
  if [[ "$full_clone" != true ]]; then
    rsync_args+=(--exclude='.password-store/' --exclude='.gnupg/private-keys-v1.d/'
      --exclude='.ssh/id_*' --exclude='.ssh/*.pem' --exclude='.ssh/*.key'
      --exclude='.config/gr/credentials' --exclude='.local/state/gr/audit/')
  fi
  rsync "${rsync_args[@]}" -- "$source" "$stage/rootfs/"
  printf '%s\n' "$source" >> "$stage/metadata/paths"
}

: > "$stage/metadata/paths"
while IFS= read -r path; do
  [[ -n "$path" && "$path" != \#* ]] || continue
  copy_relative "$path"
done < "$paths_file"

while IFS=$'\t' read -r name uid gid primary home shell supplementary; do
  [[ -n "$name" ]] || continue
  [[ -d "$home" ]] || {
    echo "Home directory does not exist for $name: $home" >&2
    exit 2
  }
  [[ ! -L "$home" ]] || { echo "Home directory may not be a symlink: $home" >&2; exit 2; }
  rsync_args=(-aHAX --numeric-ids --relative)
  if [[ "$full_clone" != true ]]; then
    rsync_args+=(--exclude='.password-store/' --exclude='.gnupg/private-keys-v1.d/'
      --exclude='.ssh/id_*' --exclude='.ssh/*.pem' --exclude='.ssh/*.key'
      --exclude='.config/gr/credentials' --exclude='.local/state/gr/audit/')
  fi
  rsync "${rsync_args[@]}" -- "$home" "$stage/rootfs/"
done < "$stage/metadata/users.tsv"

tar --numeric-owner --acls --xattrs -C "$stage" -czf - metadata rootfs
