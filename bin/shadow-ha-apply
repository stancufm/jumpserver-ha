#!/usr/bin/env bash
set -euo pipefail

[[ "$(id -u)" -eq 0 ]] || { echo 'shadow-ha-apply must run as root.' >&2; exit 2; }
readonly config="${SHADOW_HA_ROLE_FILE:-/etc/jumpserver-ha/role.conf}"
readonly state_dir="${SHADOW_HA_STATE_DIR:-/var/lib/shadow-ha-sync}"
readonly archive="${state_dir}/incoming.tar.gz"
readonly ready="${state_dir}/incoming.ready"
[[ -r "$config" ]] || { echo "Missing $config" >&2; exit 2; }
# shellcheck disable=SC1090
source "$config"
[[ "${JUMPSERVER_HA_ROLE:-}" == standby ]] || { echo 'Apply is allowed only on standby.' >&2; exit 2; }
[[ -r "$archive" && -r "$ready" ]] || { echo 'No complete HA archive is ready.' >&2; exit 0; }
if ip -4 -o addr show | grep -qF "${JUMPSERVER_HA_VIP:?missing VIP}/32"; then
  echo 'SYNC_APPLY_STATUS=skipped reason=vip_present'
  exit 0
fi

install -d -o root -g root -m 0750 "$state_dir"
exec 9>"${state_dir}/apply.lock"
flock -n 9 || { echo 'SYNC_APPLY_STATUS=busy'; exit 0; }
stage=$(mktemp -d "${state_dir}/apply.XXXXXX")
trap 'rm -rf -- "$stage"' EXIT
tar --no-same-owner --acls --xattrs -xzf "$archive" -C "$stage"
[[ -d "$stage/metadata" && -d "$stage/rootfs" ]] || { echo 'Incomplete staged archive.' >&2; exit 2; }
grep -qxF 'format=shadow-ha-v3' "$stage/metadata/manifest" || { echo 'Unsupported archive format.' >&2; exit 2; }
full_clone=$(awk -F= '$1 == "full_clone" {print $2}' "$stage/metadata/manifest")
[[ "$full_clone" == true || "$full_clone" == false ]] || { echo 'Invalid full-clone policy.' >&2; exit 2; }
configured_full_clone="${JUMPSERVER_HA_FULL_CLONE:-${JUMPSERVER_HA_SYNC_SECRETS:-false}}"
[[ "$configured_full_clone" == true || "$configured_full_clone" == false ]] || {
  echo 'Invalid locally configured full-clone policy.' >&2; exit 2;
}
[[ "$full_clone" == "$configured_full_clone" ]] || {
  echo 'Archive full-clone policy does not match the standby policy.' >&2; exit 2;
}

cut -f1 "$stage/metadata/users.tsv" | LC_ALL=C sort > "$stage/metadata/user-names"
cut -d: -f1 "$stage/metadata/shadow" | LC_ALL=C sort > "$stage/metadata/shadow-names"
if [[ "$full_clone" == true ]]; then
  cmp -s "$stage/metadata/user-names" "$stage/metadata/shadow-names" || {
    echo 'Full-clone shadow metadata does not match the selected accounts.' >&2
    exit 2
  }
elif [[ -s "$stage/metadata/shadow" ]]; then
  echo 'Partial replication archive unexpectedly contains password hashes.' >&2
  exit 2
fi

while IFS=$'\t' read -r group_name group_gid; do
  [[ "$group_name" =~ ^[a-z_][a-z0-9_-]*[$]?$ && "$group_gid" =~ ^[0-9]+$ ]] || {
    echo "Unsafe group metadata: $group_name" >&2
    exit 2
  }
  existing_by_name=$(getent group "$group_name" || true)
  existing_by_gid=$(getent group "$group_gid" || true)
  if [[ -n "$existing_by_name" ]]; then
    [[ "$(cut -d: -f3 <<<"$existing_by_name")" == "$group_gid" ]] || {
      echo "Group conflict for $group_name" >&2
      exit 2
    }
  elif [[ -n "$existing_by_gid" ]]; then
    echo "GID conflict for $group_name ($group_gid)" >&2
    exit 2
  else
    groupadd --gid "$group_gid" "$group_name"
  fi
done < "$stage/metadata/groups.tsv"

while IFS=$'\t' read -r user_name user_uid user_gid primary_group user_home user_shell supplementary; do
  [[ "$user_name" =~ ^[a-z_][a-z0-9_-]*[$]?$ && "$user_uid" =~ ^[0-9]+$ && "$user_gid" =~ ^[0-9]+$ ]] || {
    echo "Unsafe user metadata: $user_name" >&2
    exit 2
  }
  [[ "$user_home" == "/home/$user_name" && "$user_shell" == /* ]] || {
    echo "Unsafe home or shell for $user_name" >&2
    exit 2
  }
  getent group "$primary_group" >/dev/null || {
    echo "Missing primary group for $user_name" >&2
    exit 2
  }
  if [[ -n "$supplementary" && ! "$supplementary" =~ ^[a-z_][a-z0-9_-]*([$])?(,[a-z_][a-z0-9_-]*([$])?)*$ ]]; then
    echo "Unsafe supplementary groups for $user_name" >&2
    exit 2
  fi
  existing_by_name=$(getent passwd "$user_name" || true)
  existing_by_uid=$(getent passwd "$user_uid" || true)
  if [[ -n "$existing_by_name" ]]; then
    IFS=: read -r _ _ current_uid current_gid _ current_home current_shell <<<"$existing_by_name"
    [[ "$current_uid" == "$user_uid" && "$current_gid" == "$user_gid" \
       && "$current_home" == "$user_home" && "$current_shell" == "$user_shell" ]] || {
      echo "Account conflict for $user_name" >&2
      exit 2
    }
  elif [[ -n "$existing_by_uid" ]]; then
    echo "UID conflict for $user_name ($user_uid)" >&2
    exit 2
  else
    useradd --uid "$user_uid" --gid "$user_gid" --home-dir "$user_home" \
      --shell "$user_shell" --no-create-home --password '!' "$user_name"
  fi
  if [[ "$full_clone" == true ]]; then
    usermod --groups "$supplementary" "$user_name"
  elif [[ -n "$supplementary" ]]; then
    usermod --append --groups "$supplementary" "$user_name"
  fi
done < "$stage/metadata/users.tsv"

if [[ "$full_clone" == true ]]; then
  while IFS=: read -r user_name password_hash last_change minimum maximum warning inactive expire reserved; do
    [[ "$user_name" =~ ^[a-z_][a-z0-9_-]*[$]?$ ]] || {
      echo 'Unsafe shadow account metadata.' >&2; exit 2;
    }
    [[ "$last_change" =~ ^-?[0-9]+$ ]] || {
      echo "A numeric last-password-change value is required for $user_name" >&2; exit 2;
    }
    for value in "$last_change" "$minimum" "$maximum" "$warning" "$inactive" "$expire"; do
      [[ -z "$value" || "$value" =~ ^-?[0-9]+$ ]] || {
        echo "Unsafe password-aging metadata for $user_name" >&2; exit 2;
      }
    done
    printf '%s:%s\n' "$user_name" "$password_hash" | chpasswd --encrypted
    chage --mindays "${minimum:-0}" --maxdays "${maximum:--1}" \
      --warndays "${warning:-0}" --inactive "${inactive:--1}" \
      --expiredate "${expire:--1}" "$user_name"
    [[ -z "$last_change" ]] || chage --lastday "$last_change" "$user_name"
  done < "$stage/metadata/shadow"
fi

sync_secrets=$full_clone

sync_one_path() {
  local path=$1
  [[ "$path" == /* && "$path" != / && "$path" != *'/../'* && "$path" != */.. ]] || {
    echo "Unsafe synchronized path: $path" >&2
    exit 2
  }
  local source="$stage/rootfs$path"
  [[ -e "$source" ]] || { echo "Missing staged path: $path" >&2; exit 2; }
  [[ ! -L "$source" ]] || { echo "Staged root path may not be a symlink: $path" >&2; exit 2; }
  if [[ -d "$source" ]]; then
    install -d -m 0755 "$path"
    local rsync_args=(-aHAX --numeric-ids --delete --exclude='.collect.lock')
    if [[ "$sync_secrets" != true ]]; then
      rsync_args+=(--exclude='.password-store/' --exclude='.gnupg/private-keys-v1.d/'
        --exclude='.ssh/id_*' --exclude='.ssh/*.pem' --exclude='.ssh/*.key'
        --exclude='.config/gr/credentials' --exclude='.local/state/gr/audit/')
    fi
    rsync "${rsync_args[@]}" -- "$source/" "$path/"
    chmod --reference="$source" "$path"
    chown --reference="$source" "$path"
  else
    install -d -m 0755 "$(dirname "$path")"
    rsync -aHAX --numeric-ids -- "$source" "$path"
  fi
}

while IFS= read -r path; do
  [[ -n "$path" ]] || continue
  sync_one_path "$path"
done < "$stage/metadata/paths"

while IFS=$'\t' read -r user_name user_uid user_gid primary_group user_home user_shell supplementary; do
  [[ -n "$user_name" ]] || continue
  source_home="$stage/rootfs$user_home"
  [[ -d "$source_home" ]] || { echo "Missing staged home for $user_name" >&2; exit 2; }
  [[ ! -L "$source_home" ]] || { echo "Staged home may not be a symlink: $user_name" >&2; exit 2; }
  install -d -o "$user_uid" -g "$user_gid" -m 0700 "$user_home"
  rsync_args=(-aHAX --numeric-ids --delete)
  if [[ "$sync_secrets" != true ]]; then
    rsync_args+=(--exclude='.password-store/' --exclude='.gnupg/private-keys-v1.d/'
      --exclude='.ssh/id_*' --exclude='.ssh/*.pem' --exclude='.ssh/*.key'
      --exclude='.config/gr/credentials' --exclude='.local/state/gr/audit/')
  fi
  rsync "${rsync_args[@]}" -- "$source_home/" "$user_home/"
done < "$stage/metadata/users.tsv"

# Service-account numeric IDs can legitimately differ between independently
# installed peers. Restore the local GR identities after payload replication.
if getent passwd gr-collector >/dev/null 2>&1; then
  [[ -d /var/lib/gr-collector ]] && chown -R gr-collector:gr-collector /var/lib/gr-collector
  if getent group gr-config >/dev/null 2>&1 && [[ -d /var/lib/gr/config-archive ]]; then
    chown -R gr-collector:gr-config /var/lib/gr/config-archive
  fi
  [[ -f /etc/gr/collector.json ]] && chown root:gr-collector /etc/gr/collector.json
fi

install -o root -g root -m 0644 "$stage/metadata/packages.tsv" "${state_dir}/packages-active.tsv"
sha256sum "$archive" | awk '{print $1}' > "${state_dir}/last-archive.sha256"
printf '%s source=%s\n' "$(date --iso-8601=seconds)" "${JUMPSERVER_HA_ACTIVE_ADDRESS}" \
  > "${state_dir}/last-success"
chmod 0644 "${state_dir}/last-archive.sha256" "${state_dir}/last-success"
rm -f -- "$ready"
if command -v shadow-ha-packages >/dev/null 2>&1; then
  shadow-ha-packages plan --write >/dev/null
fi
logger -t shadow-ha-apply 'Passive users, homes and shared state synchronization completed.'
rm -f -- "$archive"
echo 'SYNC_APPLY_STATUS=success'
